{
  "name": "bslauncher-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply bslauncher-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bslauncher-db --remote",
    "login-test": "node tools/login-test.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.20.5",
    "msmc": "^5.0.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.100.0"
  }
}